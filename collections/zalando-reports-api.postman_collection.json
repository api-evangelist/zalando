        {
          "id": "beac95e9-c7de-4598-9eb8-2fdc6ec8062b",
          "name": "Retrieve inbounded items",
          "request": {
            "name": "Retrieve inbounded items",
            "description": {
              "content": "Returns all items inbounded at Zalando warehouses for specific `merchant-id` and `zalando_advice_ids`. Endpoint has no 100 days time limitation, but to not overload the client, it provides cursor based pagination. The cursor is a string that is returned in the response and can be used to fetch the next page of results. Please note that if `from` and `to` parameters are not provided the API will return the data for the last 100 days.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "reports",
                "received-items",
                ":merchant-id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "zalando_advice_ids",
                  "value": "<string>",
                  "description": "Zalando advice ids to filter inbounded items by. Returns items for all advice ids if not provided."
                },
                {
                  "disabled": false,
                  "key": "zalando_advice_ids",
                  "value": "<string>",
                  "description": "Zalando advice ids to filter inbounded items by. Returns items for all advice ids if not provided."
                },
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<dateTime>",
                  "description": "Start timestamp. Default is now minus 100 days."
                },
                {
                  "disabled": false,
                  "key": "to",
                  "value": "<dateTime>",
                  "description": "End timestamp. Default is now."
                },
                {
                  "disabled": false,
                  "key": "cursor",
                  "value": "<string>",
                  "description": "Cursor to paginate through results"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "100000",
                  "description": "Number of inbounded items to fetch per page. Maximum is 200000."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "merchant-id",
                  "description": "(Required) Merchant ID"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET"
          },
